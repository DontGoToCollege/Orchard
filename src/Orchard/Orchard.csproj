<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Orchard</RootNamespace>
    <AssemblyName>Orchard</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>DontGoToCollege</Authors>
    <Product>Orchard</Product>
    <Description>Make iPhone, iPad and Mac apps on Windows: designer, code editor and cloud Mac builds</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Single-file, self-contained settings are passed by publish.ps1. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <!-- The starter files every new app is made from, and the Swift colouring rules. -->
    <EmbeddedResource Include="Template\**\*" LogicalName="Template/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Swift.xshd" LogicalName="Swift.xshd" />
  </ItemGroup>

</Project>
